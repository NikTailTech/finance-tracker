# PostgreSQL connection (required)
DATABASE_URL="postgresql://money:money@localhost:5432/finance_tracker?schema=public"
# If 5432 is taken, start with POSTGRES_PORT=5433 docker compose up -d db
# and point DATABASE_URL at localhost:5433.

# App
PORT="3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: override default EUR→CHF rate used only when Settings row is missing
# DEFAULT_EUR_TO_CHF="0.95"
